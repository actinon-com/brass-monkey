    },
    "effectivity": {
      "effectivity": "selection(asap,date)",
      "effectivity_date": "datetime"
    }
  },
  "mrp.eco.type": {
    "core": {
      "name": "char"
    }
  },
  "mrp.eco.stage": {
    "core": {
      "name": "char",
      "sequence": "integer",
      "allow_apply_change": "boolean",
      "final_stage": "boolean"
    }
  },
  "mrp.eco.bom.change": {
    "core": {
      "change_type": "selection(add,remove,update)",

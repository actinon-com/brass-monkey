{
  "name": "brass-monkey",
  "version": "2.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "check-version": "node scripts/sync-version.mjs --check",
    "prebuild": "node scripts/sync-version.mjs",
    "validate-plugin": "node scripts/validate-plugin.mjs",
    "build": "npm run validate-plugin && tsc && npm run bundle && npm run build:mcpb",
    "bundle": "ncc build src/mcp-server.ts -o dist/bundle",
    "stage-mcpb": "node scripts/stage-mcpb.mjs",
    "build:mcpb": "npm run stage-mcpb && mcpb validate build/mcpb-stage/manifest.json && mcpb pack build/mcpb-stage build/brass-monkey.mcpb",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "odoo",
    "gemini",
    "gemini-cli",
    "cli",
    "extension",
    "mcp",
    "ai-agent",
    "xml-rpc",
    "erp",
    "crm"
  ],
  "author": "Actinon",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "description": "A high-fidelity Gemini CLI extension and MCP bridge for Odoo ERP/CRM.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "xmlrpc": "^1.3.2",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/keytar": "^4.4.2",
    "@types/node": "^26.2.0",
    "@types/xmlrpc": "^1.3.10",
    "@vercel/ncc": "^0.38.4",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
